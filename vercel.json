{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 30,
      "includeFiles": "{api/_fonts/**,node_modules/harfbuzzjs/*.wasm}"
    }
  },
  "rewrites": [
    { "source": "/c/:id", "destination": "/api/felt?id=:id&view=page" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/brand/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=86400" }] }
  ]
}
